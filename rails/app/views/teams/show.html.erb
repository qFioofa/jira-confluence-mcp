<div class="page-header">
  <div>
    <div class="flex items-center gap-2">
      <h1 class="page-title"><%= @team.name %></h1>
      <%= hint(t("hints.team_show")) %>
    </div>
    <p class="page-subtitle mono"><%= @team.slug %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("teams.projects"), team_projects_path(@team), class: "btn btn-primary btn-sm" %>
    <%= link_to t("teams.connections"), team_connections_path(@team), class: "btn btn-sm" %>
  </div>
</div>
<h2 class="section-title mb-3 mt-8"><%= t("teams.members_title") %></h2>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th><%= t("common.columns.email") %></th><th><%= t("common.columns.role") %></th></tr></thead>
    <tbody>
      <% @team.memberships.includes(:user).each do |membership| %>
        <tr><td><%= membership.user.email %></td><td><%= membership.role %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
