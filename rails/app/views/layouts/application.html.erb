<!DOCTYPE html>
<html lang="<%= current_locale %>">
  <head>
    <title><%= content_for(:title) || t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("jira-theme");
          var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.setAttribute("data-theme", stored || (dark ? "jira-dark" : "jira"));
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "jira");
        }
      })();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-base-200 text-base-content">
    <header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <a class="flex items-center gap-2.5" href="<%= root_path %>">
          <span class="brand-mark">J</span>
          <span class="text-base font-bold tracking-tight"><%= t("app.title") %></span>
        </a>

        <% if current_user %>
          <nav class="order-3 flex w-full items-center gap-1 overflow-x-auto sm:order-none sm:ml-6 sm:w-auto">
            <%= nav_link_to t("nav.dashboard"), root_path %>
            <%= nav_link_to t("nav.teams"), teams_path %>
            <%= nav_link_to t("nav.credentials"), user_credentials_path %>
            <%= nav_link_to t("nav.endpoints"), mcp_endpoints_path %>
          </nav>
        <% end %>

        <div class="ml-auto flex items-center gap-2 text-sm">
          <div class="hidden items-center gap-1 text-xs sm:flex" aria-label="<%= t("nav.language") %>">
            <%= link_to t("nav.english"), set_locale_path("en"),
                        class: current_locale == :en ? "font-semibold" : "link link-hover text-base-content/60" %>
            <span class="text-base-content/30">/</span>
            <%= link_to t("nav.russian"), set_locale_path("ru"),
                        class: current_locale == :ru ? "font-semibold" : "link link-hover text-base-content/60" %>
          </div>
          <button type="button" class="theme-toggle btn btn-ghost btn-sm btn-square"
                  data-theme-toggle aria-label="<%= t("nav.toggle_theme") %>" title="<%= t("nav.toggle_theme") %>">
            <svg class="theme-icon-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <% if current_user %>
            <span class="hidden max-w-48 truncate text-base-content/60 md:inline"><%= current_user.email %></span>
            <%= button_to t("nav.sign_out"), logout_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="page">
      <% if notice.present? %>
        <div class="alert alert-info mb-4 shadow-sm" role="status"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-error mb-4 shadow-sm" role="alert"><%= alert %></div>
      <% end %>
      <% if flash[:mcp_token].present? %>
        <div class="alert alert-success mb-4 shadow-sm" role="status">
          <span class="min-w-0">
            <strong class="block"><%= t("flash.mcp_token_title") %></strong>
            <code class="mono block truncate"><%= "#{request.base_url}/mcp/#{flash[:mcp_token]}" %></code>
            <span class="block text-sm"><%= t("flash.mcp_token_hint") %></span>
          </span>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <script>
      (function () {
        var button = document.querySelector("[data-theme-toggle]");
        if (!button) return;

        button.addEventListener("click", function () {
          var next = document.documentElement.getAttribute("data-theme") === "jira-dark" ? "jira" : "jira-dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("jira-theme", next);
          } catch (error) {}
        });
      })();
    </script>
  </body>
</html>
