<div class="page-header">
  <div><h1 class="page-title"><%= t("credentials.new_title") %></h1></div>
  <div class="page-actions"><%= link_to t("common.back"), user_credentials_path, class: "btn btn-sm" %></div>
</div>

<%= form_with model: @credential, class: "panel form-panel mt-6" do |form| %>
  <div class="panel-body gap-4">
    <%= render "form", form: form, credential: @credential,
               connections: Connection.joins(team: :memberships).where(memberships: { user_id: current_user.id }).order(:name) %>
    <div class="card-actions justify-end">
      <%= form.submit t("credentials.save"), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
