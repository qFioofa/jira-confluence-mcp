# ruby-jira-mcp — local environment
# Copy to .env (make does this automatically) and set the keys marked REQUIRED.
# .env is loaded by the Makefile recipes and by Docker Compose.

# --- project binding --------------------------------------------------------
# One process serves one project. JQL/CQL stay inside JIRA_KEYS / CLD_SPACE.
MCP_PROJECT_ID=alpha
MCP_PROJECT_NAME=Alpha
MCP_PROJECT_STYLE=scrum
MCP_PROJECT_ALIASES=

# --- Jira -------------------------------------------------------------------
JIRA_BASE_URL=https://acme.atlassian.net
JIRA_DEPLOYMENT=cloud
JIRA_EMAIL=dev@acme.io
# Use ONE of: API token (Cloud) or PAT (Data Center / Server).
JIRA_API_TOKEN=
JIRA_PAT=
# Allowlisted Jira project keys (comma-separated). Defaults to MCP_PROJECT_ID upcased.
JIRA_KEYS=CLD

# --- Confluence (optional) --------------------------------------------------
CONFLUENCE_BASE_URL=https://acme.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAT=
# Allowlisted space(s), comma-separated. Empty disables KB tools.
CLD_SPACE=CLD

# --- standalone MCP HTTP transport -----------------------------------------
# Loopback only by default. Docker binds 0.0.0.0 inside the container and
# publishes the port to 127.0.0.1.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp
# Extra Host headers accepted by DNS-rebinding protection (comma-separated).
MCP_HTTP_ALLOWED_HOSTS=

# --- output / queries -------------------------------------------------------
MCP_LOCALE=ru
OUTPUT_LANG=ru
OUTPUT_CHAR_LIMIT=24000
QUERY_MAX_CHARS=2000
TEAM_SHOW_EMAIL=0
TEAM_WINDOW_DAYS=180

# --- HTTP / cache -----------------------------------------------------------
HTTP_TIMEOUT_MS=20000
HTTP_KEEP_ALIVE=1
HTTP_KEEP_ALIVE_TIMEOUT=30
CACHE_ENABLED=1
CACHE_SEARCH=0
CACHE_STALE_GRACE=600
STATS_ENABLED=0
STATS_RETENTION_DAYS=7

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- Rails web UI -----------------------------------------------------------
SECRET_KEY_BASE=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
# Hosts accepted by the Rails MCP endpoint (comma-separated).
MCP_ALLOWED_HOSTS=
# Local demo data (optional).
SEED_JIRA_URL=https://example.atlassian.net
SEED_CONFLUENCE_URL=https://example.atlassian.net/wiki
SEED_JIRA_KEY=CLD
SEED_SPACE=CLD
# Production: PostgreSQL. Local compose uses SQLite under rails/storage automatically.
# DATABASE_URL=postgres://user:password@host:5432/jira_web
# CACHE_DATABASE_URL=postgres://user:password@host:5432/jira_web_cache
# QUEUE_DATABASE_URL=postgres://user:password@host:5432/jira_web_queue
