# ruby-jira-mcp — local environment
# Copy to .env (make does this automatically) and set the keys marked REQUIRED.
# .env is loaded by the Makefile recipes; direct src/bin/jira-cld does not read it.

# --- binding and site -------------------------------------------------------
MCP_PROJECT_ID=alpha

# Jira
JIRA_EMAIL=dev@acme.io


JIRA_BASE_URL=https://acme.atlassian.net
# Use ONE of: API token or PAT(personal access token)
# REQUIRED for Jira Cloud (Basic: email + API token)
JIRA_DEPLOYMENT=cloud
JIRA_API_TOKEN=
# REQUIRED for Jira Data Center / Server (Bearer)
JIRA_PAT=

CONFLUENCE_BASE_URL=https://acme.atlassian.net/wiki
# Use ONE of: API token or PAT(personal access token)
# REQUIRED for Confluence Cloud if it differs from the Jira token
CONFLUENCE_API_TOKEN=
CONFLUENCE_EMAIL=
# REQUIRED for Confluence Data Center / Server
CONFLUENCE_PAT=
CLD_SPACE=CLD
KB_ENABLED=1

# --- MCP HTTP transport (opencode connects by URL, no token) ----------------
# Loopback only by default. In Docker the image listens on 0.0.0.0 and the port
# is published to 127.0.0.1 by the Makefile.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp
# 1 = no MCP sessions (each POST is self-contained); 0 = stateful sessions
MCP_HTTP_STATELESS=0
# Extra Host headers accepted by DNS-rebinding protection (comma-separated)
MCP_HTTP_ALLOWED_HOSTS=

# --- paths ------------------------------------------------------------------
CONFIG_PATH=~/.config/jira-cld/config.yml
DATA_DIR=~/.local/share/jira-cld
# Per-project overrides are optional; leave blank to use DATA_DIR/<project>/cache.db
DB_PATH=
REFERENCE_DB_PATH=
STATS_PATH=
DB_AUTO_MIGRATE=1

# --- cache ------------------------------------------------------------------
CACHE_ENABLED=1
CACHE_L1_BYTES=8388608
CACHE_MAX_BYTES=16777216
CACHE_MAX_ENTRY_BYTES=262144
CACHE_SEARCH=0
CACHE_STALE_GRACE=600
CACHE_WRITE_BATCH=64
DB_CACHE_SIZE_KB=8192
DB_MMAP_BYTES=67108864
DB_PAGE_SIZE=8192
DB_JOURNAL_SIZE_LIMIT=16777216

# --- HTTP / queries ---------------------------------------------------------
HTTP_KEEP_ALIVE=1
HTTP_KEEP_ALIVE_TIMEOUT=30
HTTP_TIMEOUT_MS=20000
QUERY_MAX_CHARS=2000

# --- team / output ----------------------------------------------------------
TEAM_SHOW_EMAIL=0
TEAM_WINDOW_DAYS=180
MCP_LOCALE=ru
OUTPUT_LANG=ru
OUTPUT_CHAR_LIMIT=24000
SECRET_PROVIDER=env

# --- stats / UI -------------------------------------------------------------
STATS_ENABLED=1
STATS_RETENTION_DAYS=7
UI_HOST=127.0.0.1
UI_PORT=0
UI_OPEN=1
UI_LOCALE=ru
UI_THEME=system

# --- logging / runtime ------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
RUBY_GC_HEAP_GROWTH_FACTOR=1.1
RUBYOPT=--disable=did_you_mean,error_highlight,syntax_suggest
MALLOC_ARENA_MAX=2
