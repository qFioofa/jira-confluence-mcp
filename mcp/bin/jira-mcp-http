#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "jira_mcp"
require "json"
require "optparse"
require "puma"
require "rack"

options = {
  host: ENV.fetch("MCP_HTTP_HOST", "127.0.0.1"),
  port: Integer(ENV.fetch("MCP_HTTP_PORT", "8765")),
  path: ENV.fetch("MCP_HTTP_PATH", "/mcp")
}

OptionParser.new do |parser|
  parser.banner = "Usage: jira-mcp-http [options]"
  parser.on("--host HOST", "Bind host (default: #{options[:host]})") { |value| options[:host] = value }
  parser.on("--port PORT", Integer, "Bind port (default: #{options[:port]})") { |value| options[:port] = value }
  parser.on("--path PATH", "MCP path (default: #{options[:path]})") { |value| options[:path] = value }
  parser.on("-h", "--help", "Show this help") do
    puts parser
    exit 0
  end
end.parse!(ARGV)

allowed_hosts = ENV.fetch("MCP_HTTP_ALLOWED_HOSTS", "").split(",").map(&:strip).reject(&:empty?)

runtime = JiraMcp::LocalRuntime.from_env
app = JiraMcp::HTTPApp.new(
  runtime: runtime,
  path: options[:path],
  allowed_hosts: allowed_hosts
)

server = Puma::Server.new(app)
server.add_tcp_listener(options[:host], options[:port])
actual_port = begin
  server.binder.ios.first.local_address.ip_port
rescue StandardError
  options[:port]
end
url = "http://#{options[:host]}:#{actual_port}#{JiraMcp::HTTPApp.normalize_path(options[:path])}"
$stdout.puts("jira-mcp HTTP: #{url}")
$stdout.flush
runtime.logger.info("mcp http server starting", project: runtime.config.project_id, url: url)

%w[INT TERM].each do |signal|
  Signal.trap(signal) { Thread.new { server.stop(true) } }
end

begin
  server.run.join
ensure
  runtime.close
end
