# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |task|
  task.libs << "test"
  task.libs << "lib"
  task.pattern = "test/**/*_test.rb"
  task.warning = false
end

desc "Run rubocop"
task :rubocop do
  sh "bundle exec rubocop"
end

desc "Alias for rubocop"
task lint: :rubocop

desc "Verify vendored UI asset hashes"
namespace :assets do
  desc "List UI assets"
  task :list do
    root = File.expand_path("assets/ui", __dir__)
    Dir.glob(File.join(root, "**", "*")).select { |path| File.file?(path) }.sort.each do |path|
      puts path.delete_prefix("#{root}/")
    end
  end

  desc "Verify SHA256SUMS for UI assets"
  task :verify do
    require "digest"
    root = File.expand_path("assets/ui", __dir__)
    sums = File.join(root, "SHA256SUMS")
    unless File.file?(sums)
      warn "missing #{sums}"
      exit 1
    end
    failures = []
    File.readlines(sums, chomp: true).each do |line|
      next if line.strip.empty?

      digest, file = line.split(/\s+/, 2)
      path = File.join(root, file)
      unless File.file?(path)
        failures << "missing #{file}"
        next
      end
      actual = Digest::SHA256.file(path).hexdigest
      failures << "#{file}: expected #{digest}, got #{actual}" unless actual == digest
    end
    if failures.empty?
      puts "assets ok"
    else
      failures.each { |failure| warn failure }
      exit 1
    end
  end
end

desc "Measure RSS and cold start"
namespace :memory do
  task :measure do
    require "json"
    script = File.expand_path("bin/jira-cld", __dir__)
    puts "baseline (version):"
    system("/usr/bin/time", "-f", "rss=%MKB elapsed=%e", RbConfig.ruby, script, "version")
    puts "mcp idle (no tools called):"
    system("/usr/bin/time", "-f", "rss=%MKB elapsed=%e", RbConfig.ruby, script, "mcp",
           in: File::NULL, out: File::NULL)
  end
end

desc "Measure cache latency (L2 get/upsert)"
namespace :latency do
  task :measure do
    require "benchmark"
    require "securerandom"
    $LOAD_PATH.unshift(File.expand_path("lib", __dir__))
    require "jira_cld"
    config = JiraCld::Config.new(
      env: ENV.to_h.merge("DATA_DIR" => "/tmp/jira-cld-latency-#{SecureRandom.hex(4)}"),
      document: JiraCld::ConfigStore.default_document,
      config_path: "/tmp/jira-cld-latency.yml",
      project_id: nil
    )
    JiraCld::DB.setup!(config)
    store = JiraCld::Cache::DatabaseStore.new(
      max_bytes: config.cache_max_bytes, stale_grace: config.cache_stale_grace,
      max_entry_bytes: config.cache_max_entry_bytes
    )
    1000.times do |i|
      store.write_record("k#{i}", { "value" => "x" * 1024 }, ns: "bench", ttl: 3600)
    end
    reads = 2000
    elapsed = Benchmark.realtime { reads.times { |i| store.read_record("k#{i % 1000}") } }
    get_us = (elapsed / reads) * 1_000_000
    puts "L2 get p50-ish: #{get_us.round(1)} us/op (#{reads} ops)"
    elapsed = Benchmark.realtime do
      100.times do |batch|
        store.write_multi_records((0...64).map do |i|
          { key: "b#{batch}-#{i}", ns: "bench", value: { "v" => i }, ttl: 3600 }
        end)
      end
    end
    batch_ms = (elapsed / 100) * 1000
    puts "batch upsert 64: #{batch_ms.round(2)} ms/batch"
    raise "L2 get p95 budget exceeded" if get_us > 2000
    raise "batch upsert budget exceeded" if batch_ms > 10
  ensure
    JiraCld::DB.disconnect!
  end
end

task default: :test
