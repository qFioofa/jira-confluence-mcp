<h1><%= project.name %> / Cache</h1>
<%== helpers.project_tabs(project, "cache") %>
<% if error %><div class="notice error"><%= error %></div><% end %>
<table>
  <thead><tr><th>namespace</th><th class="num">entries</th><th class="num">bytes</th><th>oldest</th></tr></thead>
  <tbody>
    <% rows.each do |row| %>
      <tr><td><%= row[:namespace] %></td><td class="num"><%= row[:entries] %></td><td class="num"><%= row[:bytes] %></td><td class="mono"><%= row[:oldest] %></td></tr>
    <% end %>
    <% if rows.empty? %>
      <tr><td colspan="4" class="muted"><%= helpers.t("Кэш пуст", "Cache is empty") %></td></tr>
    <% end %>
  </tbody>
</table>
<p class="muted mono"><%= helpers.format_bytes(bytes) %> · <%= db_path %></p>

<h2><%= helpers.t("Очистка кэша", "Clear cache") %></h2>
<form method="post" action="/projects/<%= project.id %>/cache/clear">
  <%== helpers.csrf_field %>
  <label for="scope"><%= helpers.t("Scope", "Scope") %></label>
  <select id="scope" name="scope">
    <option value="expired">expired</option>
    <option value="all">all</option>
  </select>
  <label for="namespace"><%= helpers.t("Namespace (опционально)", "Namespace (optional)") %></label>
  <input id="namespace" name="namespace" placeholder="issue, page, search...">
  <p><button class="danger" type="submit"><%= helpers.t("Очистить", "Clear") %></button></p>
</form>
<p class="muted"><%= helpers.t("Очистка только для выбранного проекта. GET ничего не удаляет.", "Clears only the selected project. GET never deletes.") %></p>
