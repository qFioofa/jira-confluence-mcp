<h1><%= helpers.t("Диагностика", "Diagnostics") %></h1>
<%== helpers.partial("settings/tabs", { section: section }) %>
<table>
  <thead><tr><th>item</th><th>value</th></tr></thead>
  <tbody>
    <tr><td>version</td><td class="mono"><%= JiraCld::VERSION %></td></tr>
    <tr><td>ruby</td><td class="mono"><%= RUBY_VERSION %></td></tr>
    <tr><td>config</td><td class="mono"><%= config.config_path %></td></tr>
    <tr><td>data</td><td class="mono"><%= config.data_dir %></td></tr>
    <tr><td>stats</td><td class="mono"><%= config.stats_path %></td></tr>
    <tr><td>trash</td><td class="mono"><%= config.registry.trash_size %> bytes</td></tr>
  </tbody>
</table>
<h2>opencode.json</h2>
<pre class="mono"><%= JSON.pretty_generate("mcp" => { "servers" => { "jira-#{project ? project.id : "alpha"}" => {
  "type" => "local", "command" => ["bundle", "exec", "bin/jira-cld", "mcp"],
  "cwd" => Dir.pwd, "pool" => false,
  "environment" => { "MCP_PROJECT_ID" => project ? project.id : "alpha",
                     "JIRA_API_TOKEN" => "{env:JIRA_API_TOKEN}" } } } }) %></pre>
