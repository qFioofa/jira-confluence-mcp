<h1><%= helpers.t("Настройки", "Settings") %></h1>
<%== helpers.partial("settings/tabs", { section: section }) %>
<table>
  <thead><tr><th>setting</th><th>value</th></tr></thead>
  <tbody>
    <tr><td>locale</td><td><%= context.locale %></td></tr>
    <tr><td>theme</td><td><%= context.theme %></td></tr>
    <tr><td>output char limit</td><td class="mono"><%= config.output_char_limit %></td></tr>
    <tr><td>cache L1</td><td class="mono"><%= config.cache_l1_bytes %> bytes</td></tr>
    <tr><td>cache L2</td><td class="mono"><%= config.cache_max_bytes %> bytes</td></tr>
    <tr><td>KB enabled</td><td><%= config.kb_enabled? %></td></tr>
    <tr><td>search cache</td><td><%= config.cache_search? %></td></tr>
  </tbody>
</table>
<p class="muted"><%= helpers.t("Изменение соединений и проектов — через wizard/edit или CLI setup.", "Change connections and projects via wizard/edit or CLI setup.") %></p>
