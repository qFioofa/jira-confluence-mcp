<h1><%= project ? project.name : "Checks" %> / Checks</h1>
<% if project %><%== helpers.project_tabs(project, "checks") %><% end %>
<table>
  <thead><tr><th>check</th><th>status</th><th>detail</th></tr></thead>
  <tbody>
    <% checks.each do |check| %>
      <tr>
        <td class="mono"><%= check[:name] %></td>
        <td class="<%= helpers.status_class(check[:status]) %>">[<%= check[:status] %>]</td>
        <td class="mono"><%= check[:detail] %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<p class="muted"><%= helpers.t("Checks только читают. Сетевые проверки — `bin/jira-cld doctor`.", "Checks are read-only. Run `bin/jira-cld doctor` for network probes.") %></p>
