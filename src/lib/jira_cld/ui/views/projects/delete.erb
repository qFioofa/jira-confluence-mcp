<h1><%= helpers.t("Удалить проект", "Delete project") %></h1>
<div class="notice error">
  <p><%= helpers.t("Проект будет удалён из config.yml, а каталог перемещён в .trash. stats.db и global/reference.db сохранятся.", "The project will be removed from config.yml and its directory moved to .trash. stats.db and global/reference.db are preserved.") %></p>
  <p class="mono"><%= project.data_dir %></p>
</div>
<div class="card">
  <p><%= helpers.t("Введите id проекта для подтверждения:", "Type the project id to confirm:") %> <strong class="mono"><%= project.id %></strong></p>
  <form method="post" action="/projects/<%= project.id %>/delete">
    <%== helpers.csrf_field %>
    <label for="confirm"><%= helpers.t("Подтверждение", "Confirmation") %></label>
    <input id="confirm" name="confirm" required autocomplete="off" placeholder="<%= project.id %>">
    <p class="actions">
      <button class="danger" type="submit"><%= helpers.t("Удалить навсегда", "Delete permanently") %></button>
      <a href="/projects/<%= project.id %>"><%= helpers.t("Отмена", "Cancel") %></a>
    </p>
  </form>
</div>
