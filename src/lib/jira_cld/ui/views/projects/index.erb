<div class="actions spread">
  <h1><%= helpers.t("Проекты", "Projects") %></h1>
  <a class="button primary" href="/projects/new"><%= helpers.t("Добавить проект", "Add project") %></a>
</div>
<div class="tabs">
  <a class="active" href="/projects"><%= helpers.t("Список", "List") %></a>
</div>
<table>
  <thead><tr><th>id</th><th>name</th><th>jira</th><th>spaces</th><th>style</th><th></th></tr></thead>
  <tbody>
    <% projects.each do |project| %>
      <tr>
        <td class="mono"><%= project.id %></td>
        <td><%= project.name %></td>
        <td><%= project.jira_keys.join(", ") %></td>
        <td><%= project.spaces.join(", ") %></td>
        <td><%= project.style %></td>
        <td class="actions">
          <a href="/projects/<%= project.id %>"><%= helpers.t("Открыть", "Open") %></a>
          <a href="/projects/<%= project.id %>/edit"><%= helpers.t("Изменить", "Edit") %></a>
          <% if active_project && active_project.id == project.id %>
            <span class="muted"><%= helpers.t("активный", "active") %></span>
          <% else %>
            <a class="danger-link" href="/projects/<%= project.id %>/delete"><%= helpers.t("Удалить", "Delete") %></a>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if projects.empty? %>
      <tr><td colspan="6" class="muted"><%= helpers.t("Проектов нет", "No projects") %></td></tr>
    <% end %>
  </tbody>
</table>
<p class="muted"><%= helpers.t("Удаление — soft-delete в .trash; stats.db сохраняется.", "Delete is a soft-delete to .trash; stats.db is preserved.") %></p>
