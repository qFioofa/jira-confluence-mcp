<div class="card">
  <form method="post" action="<%= form_action %>">
    <%== helpers.csrf_field %>
    <% unless project %>
      <label for="id">id</label>
      <input id="id" name="id" required pattern="[a-zA-Z0-9][a-zA-Z0-9_.-]*" placeholder="alpha">
    <% end %>
    <label for="name"><%= helpers.t("Название", "Name") %></label>
    <input id="name" name="name" value="<%= project ? project.name : "" %>" required>

    <label for="jira_keys"><%= helpers.t("Jira keys (через запятую)", "Jira keys (comma separated)") %></label>
    <input id="jira_keys" name="jira_keys" value="<%= project ? project.jira_keys.join(", ") : "" %>" required placeholder="ALP">

    <label for="spaces"><%= helpers.t("Confluence spaces (через запятую)", "Confluence spaces (comma separated)") %></label>
    <input id="spaces" name="spaces" value="<%= project ? project.spaces.join(", ") : "" %>" required placeholder="ALP_KB">

    <label for="style"><%= helpers.t("Стиль", "Style") %></label>
    <select id="style" name="style">
      <% %w[scrum kanban].each do |style| %>
        <option value="<%= style %>" <%= "selected" if project && project.style == style %>><%= style %></option>
      <% end %>
    </select>

    <p class="actions">
      <button class="primary" type="submit"><%= helpers.t("Сохранить", "Save") %></button>
      <a href="<%= project ? "/projects/#{project.id}" : "/projects" %>"><%= helpers.t("Отмена", "Cancel") %></a>
    </p>
  </form>
</div>
<p class="muted"><%= helpers.t("Wizard не удаляет проекты. Удаление доступно только в Projects.", "The wizard never deletes. Deletion is only available in Projects.") %></p>
