#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

if ENV["JIRA_CLD_BOOTSTRAPPED"] != "1"
  rubyopt = ENV["RUBYOPT"].to_s
  unless rubyopt.include?("--disable")
    rubyopt = "#{rubyopt} --disable=did_you_mean,error_highlight,syntax_suggest".strip
  end
  env = {
    "RUBY_GC_HEAP_GROWTH_FACTOR" => ENV["RUBY_GC_HEAP_GROWTH_FACTOR"] || "1.1",
    "RUBYOPT" => rubyopt,
    "JIRA_CLD_BOOTSTRAPPED" => "1"
  }
  env["MALLOC_ARENA_MAX"] ||= "2" if ARGV.first == "ui"
  exec(env, RbConfig.ruby, File.expand_path(__FILE__), *ARGV)
end

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "jira_cld"
require "jira_cld/cli/app"

exit JiraCld::CLI::App.new(ARGV).run
